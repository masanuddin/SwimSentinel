# Salin file ini jadi .env.local lalu isi dari dashboard Supabase:
# Project Settings -> API -> Project URL & anon public key.
# .env.local ke-ignore git (pattern *.local) — jangan commit kredensial.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- CV service ---------------------------------------------------------- #
# Semua opsional — nilai di bawah ini sudah jadi default kalau tidak diisi.
# Frontend dan cv-service sama-sama baca .env.local, jadi cukup satu file.

# Base URL cv-service. Frontend connect ke `${VITE_CV_SERVICE_URL}/events`.
VITE_CV_SERVICE_URL=http://127.0.0.1:8000

CV_MODE=mock
CV_CAMERA_ID=POOL-CAM-01
CV_MODEL_PATH=cv-service/models/best.pt
CV_CONFIG_DIR=cv-service/config
CV_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CV_HOST=127.0.0.1
CV_PORT=8000
CV_LOG_LEVEL=INFO

# Mode video/camera (mock = tanpa model & kamera, default).
# CV_MODE=video
# CV_CAMERA_SOURCE=C:/footage/pool.mp4   # path file, index kamera (mis. 0), atau URL stream
# CV_LOOP_VIDEO=false                    # ulang file rekaman
# CV_VIDEO_REALTIME=true                 # putar file sesuai FPS aslinya (lihat cv-service/README.md)
# CV_ZONES_FILE=zones.example.json
